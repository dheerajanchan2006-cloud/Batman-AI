# =======================================================
# NEXUS AI - CONFIGURATION
# =======================================================

# 1. Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. Secret key for secure user sessions (can be any random string in development)
FLASK_SECRET_KEY=nexus_ai_super_secret_dev_key_2026_x89f_quantum

# 3. Default Groq Model
# Options: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b, groq/compound
DEFAULT_MODEL=openai/gpt-oss-120b

# 4. Port to run the application
PORT=5000
